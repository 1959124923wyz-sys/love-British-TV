          "1580S-E030",
          "1580S-E027"
        ],
        "year_stages": [
          {
            "start_year": 1584,
            "end_year": 1585,
            "title": "芒斯特：被没收土地清查与殖民筹备",
            "summary_zh": "1584年委任调查人员清查德斯蒙德战争后被宣布没收的土地。存世文献显示土地权利、地名与调查精度均存在问题；此面仅定位调查涉及的芒斯特地区，不能当作具体被没收地块。",
            "source_ids": [
              "C10-S05"
            ]
          },
          {
            "start_year": 1586,
            "end_year": 1587,
            "title": "芒斯特：王室殖民庄园规划与分封",
            "summary_zh": "1586年王室批准没收土地的庄园分配和租金等安排，并限制部分本地爱尔兰人的承领资格；法律分配和实际入住不能混同。",
            "source_ids": [
              "C10-S05",
              "C10-S08",
              "C10-S69"
            ]
          },
          {
            "start_year": 1588,
            "end_year": 1588,
            "title": "芒斯特：庄园殖民的实际落实与差距",
            "summary_zh": "研究资料显示早期实际获得地块的英方承领者少于原计划，此区域仅反映殖民政策所涉及的芒斯特，不表示1588年全域完成土地转移。",
            "source_ids": [
              "C10-S05",
              "C10-S70"
            ]
          },
          {
            "start_year": 1589,
            "end_year": 1589,
            "title": "芒斯特：乔布森殖民庄园地图所涉地区",
            "summary_zh": "1589年绘制的芒斯特庄园图可用于研究申请者与规划的空间分布，但尚未据原图核实、数字化每一块地契；不能由此概略范围推断实际承领面积。",
            "source_ids": [
              "C10-S05",
              "C10-S06",
              "C10-S08"
            ]
          }
        ],
        "research_geo_method": "Literal reuse of a previous schematic Munster province reading polygon; not copied from Jobson's 1589 map or 1586 original estate survey, and cannot represent parcel boundaries",
