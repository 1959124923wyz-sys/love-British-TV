        ],
        "coordinate_semantics": "modern_site_or_region_reference_not_original_16c_map_coordinate",
        "geo_precision": "historic_port_identification_scholarship_modern_city_approx",
        "actor": "英格兰私人商业航次；不代表英王占领",
        "research_confidence": "documented_visit_historic_port_identification_approx"
      }
    },
