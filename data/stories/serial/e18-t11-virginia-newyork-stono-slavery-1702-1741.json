{
  "schema": "atlas-major-history-story-v1",
  "id": "E18-T11-VIRGINIA-NEWYORK-STONO-SLAVERY-1702-1741",
  "title": "1702—1741年英属北美奴役刑法、纽约起义与Stono镇压",
  "subtitle": "弗吉尼亚杀害免责法、1712年纽约殖民处决、1739年Stono争取自由、1740年奴役法和1741年纽约审判",
  "region": "弗吉尼亚、纽约、马里兰、南卡罗来纳、英属佐治亚与西属佛罗里达",
  "start_year": 1702,
  "end_year": 1741,
  "historical_end_year": null,
  "lead": "英国北美殖民当局从1702年纽约规制黑人集会到1705年弗吉尼亚将强制劳动与私产绑定，将逃亡、旅行和身体惩罚写入法律。1712年纽约被奴役者武装起义后殖民法院执行死刑并修订刑法；1729年马里兰法允许断肢和分尸；1739年Stono被奴役者争取自由，随即遭殖民民兵杀害和追捕。1740年南卡通过系统奴役法；同时来自英属卡罗来纳的逃亡黑人在西属Fort Mose建立自由社群，1740年抵抗英军入侵。1741年纽约纵火恐慌引发缺少充分证据的大规模审判、处决及流放。",
  "publication_status": "research_only",
  "publication_review": "not_submitted",
  "editorial_status": "research_preview_not_published",
  "publication_approval": "not_submitted",
  "series_family": [
    "T11"
  ],
