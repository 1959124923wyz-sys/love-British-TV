  "sections": [
    {
      "id": "1702-new-york-slave-code",
      "heading": "一、纽约殖民议会把奴役者集会限制写入刑法",
      "period_start_year": 1702,
      "period_end_year": 1702,
      "source_keys": [
        "18CT11-NYPL-BLACK",
        "18CT11-NYCOURTS-1702"
      ],
      "paragraphs": [
        "在1702年，[[E18C-T11-1702-NEW-YORK-SLAVE-CODE|纽约殖民议会把奴役者集会限制写入刑法]]。1702年纽约议会扩大奴役者主人对被奴役者的惩罚权，并限制三人以上集会。",
        "英治纽约的被奴役劳动者在码头、作坊和家庭中承担大量工作。城镇空间紧凑，使他们能够接触彼此，也使殖民官署越来越重视限制集会。",
        "法律把奴役者的身体和聚会变成私人主人与殖民治安机构的共同管理对象，为其后的军事与司法镇压提供了制度基础。"
      ]
    },
    {
      "id": "1705-virginia-slave-property",
      "heading": "二、弗吉尼亚议会将被奴役人口作为可继承财产",
      "period_start_year": 1705,
      "period_end_year": 1705,
      "source_keys": [
        "18CT11-VCDH-1705",
        "18CT11-EV-VA1705",
        "18CT11-ORIG-N40",
        "18CT11-ORIG-N41",
        "18CT11-ORIG-S74"
      ],
      "paragraphs": [
        "在1705年，[[E18C-T11-1705-VIRGINIA-SLAVE-PROPERTY|弗吉尼亚议会将被奴役人口作为可继承财产]]。1705年殖民弗吉尼亚一系列法令把黑人、混血与被奴役原住民的法律地位同种植园财产制度联结。",
        "英属弗吉尼亚的烟草经济需要长期稳定的强制劳动力，议会因此在土地、继承、买卖和身份认定上强化奴役秩序。",
        "所谓财产地位使殖民庄园主能在债务和遗产安排中处分他人劳动与身体，进一步固定世袭剥夺。"
      ]
    },
    {
      "id": "1705-virginia-travel-pass",
      "heading": "三、弗吉尼亚限制被奴役者离开庄园",
      "period_start_year": 1705,
      "period_end_year": 1705,
      "source_keys": [
        "18CT11-EV-VA1705",
        "18CT11-VCDH-1705"
      ],
      "paragraphs": [
        "在1705年，[[E18C-T11-1705-VIRGINIA-TRAVEL-PASS|弗吉尼亚限制被奴役者离开庄园]]。1705年《仆役与奴役者法》要求离庄者持主人书面通行许可，违者可由治安人员执行鞭笞。",
        "一个人即使在同一殖民地内寻找家属或临时劳动，也可能因为缺少主人签发的许可而被拦截。",
        "法条把出行自由交由奴役主控制，并授权地方警员对被捕者实施体罚。"
      ]
    },
    {
      "id": "1705-virginia-killing-immunity",
      "heading": "四、弗吉尼亚奴役法容许主人惩罚致死免责",
      "period_start_year": 1705,
      "period_end_year": 1705,
      "source_keys": [
        "18CT11-EV-VA1705",
        "18CT11-EV-RUNAWAY"
      ],
      "paragraphs": [
        "在1705年，[[E18C-T11-1705-VIRGINIA-KILLING-IMMUNITY|弗吉尼亚奴役法容许主人惩罚致死免责]]。1705年法典规定奴役者在所谓纠正过程中抵抗而被杀，施行纠正的主人或代理人可免于刑责。",
        "奴役法律将反抗主人命令的风险转嫁给被奴役者，允许殖民主在特定条件下施用致命暴力。",
        "法律授权与某次实际死亡记录分开；具体被害者人数需要另查法院和种植园档案。"
      ]
    },
    {
      "id": "1705-virginia-runaway-hunt",
      "heading": "五、弗吉尼亚授权地方追捕逃亡者",
      "period_start_year": 1705,
      "period_end_year": 1705,
      "source_keys": [
        "18CT11-EV-VA1705",
        "18CT11-EV-RUNAWAY"
      ],
      "paragraphs": [
        "在1705年，[[E18C-T11-1705-VIRGINIA-RUNAWAY-HUNT|弗吉尼亚授权地方追捕逃亡者]]。1705年法令授权郡治安法官通告追捕隐匿林地的逃亡被奴役者，在符合所列程序时容许杀害拒不归返者。",
        "逃离庄园的道路通向林地和沼泽。议会命令地方教会公布追捕告示，警长可组织人手搜索。",
        "奖赏、通行文书和惩罚规则，把奴役主的私人追捕权与殖民司法权连接起来。"
      ]
    },
    {
      "id": "1706-cornbury-fire-order",
      "heading": "六、纽约总督命令拘捕拒捕者可开枪杀害",
      "period_start_year": 1706,
      "period_end_year": 1706,
      "source_keys": [
        "18CT11-NYPL-BLACK"
      ],
      "paragraphs": [
        "在1706年，[[E18C-T11-1706-CORNBURY-FIRE-ORDER|纽约总督命令拘捕拒捕者可开枪杀害]]。1706年7月22日总督Cornbury命令Kings County官员搜捕被怀疑聚集或逃亡的黑人，拒捕且无法抓获时授权开枪。",
        "布鲁克林所在的Kings County有许多被奴役者在农场劳动；殖民政府把他们的聚集视作治安威胁。",
        "这是官方发布的授权暴力命令。现有材料并未给出该命令造成的具体死亡人数。"
      ]
    },
    {
      "id": "1712-new-york-maiden-rising",
      "heading": "七、纽约被奴役者在Maiden Lane发动起义",
      "period_start_year": 1712,
      "period_end_year": 1712,
      "source_keys": [
        "18CT11-COLUMBIA-1712",
        "18CT11-NYPL-BLACK"
      ],
      "paragraphs": [
        "在1712年，[[E18C-T11-1712-NEW-YORK-MAIDEN-RISING|纽约被奴役者在Maiden Lane发动起义]]。1712年4月6日纽约的被奴役非洲裔在Maiden Lane附近纵火，持武器攻击前来扑火的白人殖民者。",
        "纽约的被奴役工匠、船工和家仆生活在一个高度依赖他们劳动的港市。少数参与者希望用集体行动挣脱奴役。",
        "这场起义发生在殖民城市边缘的道路与果园附近，史料反映了有组织的反抗和殖民社会的紧张。"
      ]
    },
    {
      "id": "1712-new-york-white-casualties",
      "heading": "八、纽约起义者杀死殖民者并造成伤者",
      "period_start_year": 1712,
      "period_end_year": 1712,
      "source_keys": [
        "18CT11-COLUMBIA-1712",
        "18CT11-NYPL-BLACK"
      ],
      "paragraphs": [
        "在1712年，[[E18C-T11-1712-NEW-YORK-WHITE-CASUALTIES|纽约起义者杀死殖民者并造成伤者]]。1712年Maiden Lane起义中九名白人殖民者死亡，受伤人数在大学资料与其他研究记载之间存在差异。",
        "纵火吸引人群到场后，起义者用刀、枪和其他武器攻击赶来者。部分受害者是殖民奴役社会的成员。",
        "同一事件中的白人死亡、殖民军追捕与被奴役者遭处决属于不同责任主体的行动。"
      ]
    },
    {
      "id": "1712-new-york-militia-roundup",
      "heading": "九、纽约殖民民兵大规模搜捕黑人居民",
      "period_start_year": 1712,
      "period_end_year": 1712,
      "source_keys": [
        "18CT11-COLUMBIA-1712",
        "18CT11-NYPL-BLACK"
      ],
      "paragraphs": [
        "在1712年，[[E18C-T11-1712-NEW-YORK-MILITIA-ROUNDUP|纽约殖民民兵大规模搜捕黑人居民]]。1712年起义后纽约与Westchester民兵展开追捕，并将数十名黑人拘押；起诉及释放人数依各史料统计口径有差异。",
        "殖民官署动员沿岸驻兵和郡民兵，封锁逃离路线，搜寻参与起义的居民。",
        "这次搜捕扩大到被怀疑参与起义的人群，许多被拘押者随后接受殖民地法院审讯。"
      ]
    },
    {
      "id": "1712-new-york-executions",
      "heading": "一零、纽约法院处决被指控参与起义的黑人",
      "period_start_year": 1712,
      "period_end_year": 1712,
      "source_keys": [
        "18CT11-COLUMBIA-1712",
        "18CT11-NYPL-BLACK",
        "18CT11-ORIG-N47",
        "18CT11-ORIG-N48",
        "18CT11-ORIG-S83"
      ],
      "paragraphs": [
        "在1712年，[[E18C-T11-1712-NEW-YORK-EXECUTIONS|纽约法院处决被指控参与起义的黑人]]。1712年起义后殖民法庭判处多人死刑，处刑方式包括绞刑与火刑；不同馆藏对具体人数和方式记载不完全一致。",
        "这批处决是英治纽约殖民司法直接实施的暴力。被审判者的供述、证人陈述与法庭程序仍需结合原件逐案梳理。",
        "哥伦比亚大学项目与纽约公共图书馆整理使用不同统计，研究台账保留各自口径，避免合成为伪精确总数。"
      ]
    },
    {
      "id": "1712-new-york-december-penal-law",
      "heading": "一一、纽约殖民议会通过起义惩罚法",
      "period_start_year": 1712,
      "period_end_year": 1712,
      "source_keys": [
        "18CT11-NY1712-ACT",
        "18CT11-NYPL-BLACK"
      ],
      "paragraphs": [
        "在1712年，[[E18C-T11-1712-NEW-YORK-DECEMBER-PENAL-LAW|纽约殖民议会通过起义惩罚法]]。1712年12月10日纽约通过专门针对被奴役者的起义、阴谋、武器和审讯法，对被定罪者扩大死刑处置。",
        "殖民政权在武装反抗之后扩张司法权，规定治安法官和自由地产持有者参与审判。",
        "新的法规同时约束被奴役者持有武器和自由身份的实现，法律与1712年实际判决须分别记录。"
      ]
    },
    {
      "id": "1729-maryland-mutilation-act",
      "heading": "一二、马里兰议会授权死刑与肢解示众",
      "period_start_year": 1729,
      "period_end_year": 1729,
      "source_keys": [
        "18CT11-MD1729-LAW",
        "18CT11-UNB1729",
        "18CT11-ORIG-V6004"
      ],
      "paragraphs": [
        "在1729年，[[E18C-T11-1729-MARYLAND-MUTILATION-ACT|马里兰议会授权死刑与肢解示众]]。1729年8月8日马里兰殖民议会准许法院对某些被奴役者罪名判处断手、绞刑、斩首、分尸与公开展示。",
        "马里兰法条将种族化暴力直接写入刑事判罚体系，其严厉程度针对被奴役者的特定罪名。",
        "该法授权法院作此判决，现有核对证据不支持推定当年每种刑罚均有实际执行案例。"
      ]
    },
    {
      "id": "1735-georgia-slavery-ban",
      "heading": "一三、英属乔治亚托管殖民地颁布奴役禁令",
      "period_start_year": 1735,
      "period_end_year": 1735,
      "source_keys": [
        "18CT11-GEORGIA-1735",
        "18CT11-GEORGIA-CHARTER",
        "18CT11-ORIG-V310",
        "18CT11-ORIG-V311",
        "18CT11-ORIG-V312"
      ],
      "paragraphs": [
        "在1735年，[[E18C-T11-1735-GEORGIA-SLAVERY-BAN|英属乔治亚托管殖民地颁布奴役禁令]]。1735年英王和枢密院支持托管人提出的法案，禁止在英属乔治亚使用黑人奴役劳动，后于1751年取消。",
        "托管人希望维持小业主与白人劳动力的殖民结构，也担忧逃亡黑人与西属佛罗里达联合抵抗。",
        "这一禁令体现了英属北美各殖民政府政策不同；乔治亚禁令不等于整个英帝国废除奴役。"
      ]
    },
    {
      "id": "1738-spanish-fort-mose-freedom",
      "heading": "一四、西班牙佛罗里达允许逃离英属殖民地者建立Fort Mose",
      "period_start_year": 1738,
      "period_end_year": 1738,
      "source_keys": [
        "18CT11-NPS-MOSE",
        "18CT11-FL-PARK-MOSE",
        "18CT11-ORIG-V313",
        "18CT11-ORIG-V314",
        "18CT11-ORIG-V316"
      ],
      "paragraphs": [
        "在1738年，[[E18C-T11-1738-SPANISH-FORT-MOSE-FREEDOM|西班牙佛罗里达允许逃离英属殖民地者建立Fort Mose]]。1738年西班牙总督Montiano允许英属卡罗来纳逃出的非洲裔居民在圣奥古斯丁附近建立自由黑人军事聚落Fort Mose。",
        "逃亡居民选择跨过殖民地边界、接受西班牙统治条件，以保护自己与家人免于重新被英属庄园主奴役。",
        "Fort Mose是西班牙治下黑人社群，不属于英属占领区；其军事自卫也为后来英军入侵提供了背景。"
      ]
    },
    {
      "id": "1739-stono-september-rising",
      "heading": "一五、Stono河畔被奴役者举旗争取自由",
      "period_start_year": 1739,
      "period_end_year": 1739,
      "source_keys": [
        "18CT11-LOC-STONO",
        "18CT11-CCPL-STONO",
        "18CT11-SC-ENC-STONO",
        "18CT11-ORIG-R11",
        "18CT11-ORIG-R12",
        "18CT11-ORIG-V6022",
        "18CT11-ORIG-V6023"
      ],
      "paragraphs": [
        "在1739年，[[E18C-T11-1739-STONO-SEPTEMBER-RISING|Stono河畔被奴役者举旗争取自由]]。1739年9月9日约20名被奴役非洲裔在南卡Stono河一带夺取武器并向西属佛罗里达方向行进。",
        "参加者沿途呼喊自由，另有被奴役者加入，目标之一是离开英国殖民奴役体系。",
        "查尔斯顿郡图书馆指出现代Wallace Creek纪念碑只在已知路线附近，并非已证实的最初聚集点。"
      ]
    },
    {
      "id": "1739-stono-settler-killings",
      "heading": "一六、Stono起义者袭击庄园与殖民商店",
      "period_start_year": 1739,
      "period_end_year": 1739,
      "source_keys": [
        "18CT11-LOC-STONO",
        "18CT11-SC-ENC-STONO",
        "18CT11-UGA-1740"
      ],
      "paragraphs": [
        "在1739年，[[E18C-T11-1739-STONO-SETTLER-KILLINGS|Stono起义者袭击庄园与殖民商店]]。1739年Stono起义者夺取枪支与火药，沿路袭击商店和若干殖民住宅，造成白人殖民者死亡。",
        "参加者试图在英国殖民军赶到前扩充队伍并推进到可以逃离奴役的地区。",
        "起义者造成的死亡与后续英国殖民民兵对起义者的杀害分开记录。"
      ]
    },
    {
      "id": "1739-stono-militia-killings",
      "heading": "一七、南卡殖民民兵杀害并追捕Stono起义者",
      "period_start_year": 1739,
      "period_end_year": 1739,
      "source_keys": [
        "18CT11-SC-ENC-STONO",
        "18CT11-LOC-STONO",
        "18CT11-CCPL-STONO",
        "18CT11-ORIG-R11"
      ],
      "paragraphs": [
        "在1739年，[[E18C-T11-1739-STONO-MILITIA-KILLINGS|南卡殖民民兵杀害并追捕Stono起义者]]。1739年9月南卡殖民民兵追上Stono起义队伍并开火，造成多名黑人起义者死亡，部分幸存者在事后遭追捕处决。",
        "白人殖民者组织武装反击，阻止起义者到达西属佛罗里达。战斗中双方均有死亡。",
        "史料使用不同的死亡总数和阶段划分，具体战场及事后处决的个别姓名仍待进一步核对。"
      ]
    },
    {
      "id": "1740-south-carolina-negro-act",
      "heading": "一八、南卡罗来纳通过系统性奴役法典",
      "period_start_year": 1740,
      "period_end_year": 1740,
      "source_keys": [
        "18CT11-UNB1740-LAW",
        "18CT11-SC-ENC-STONO",
        "18CT11-ORIG-R13",
        "18CT11-ORIG-R11",
        "18CT11-ORIG-V6005"
      ],
      "paragraphs": [
        "在1740年，[[E18C-T11-1740-SOUTH-CAROLINA-NEGRO-ACT|南卡罗来纳通过系统性奴役法典]]。1740年5月10日南卡殖民议会通过《更好管理黑人及其他奴役者法》，重新确认母系世袭奴役、劳动力财产身份和对行动的限制。",
        "Stono起义后，种植园主希望加强对被奴役者行动、劳动与集会的控制。法条还将被奴役者明确界定为私人财产。",
        "法律内有针对奴役主过度暴力的罚金规定，但仍维持人身控制和买卖体系。"
      ]
    },
    {
      "id": "1740-sc-passes-and-drums",
      "heading": "一九、南卡法律限制被奴役者聚会、鼓声和外出",
      "period_start_year": 1740,
      "period_end_year": 1740,
      "source_keys": [
        "18CT11-UNB1740-LAW"
      ],
      "paragraphs": [
        "在1740年，[[E18C-T11-1740-SC-PASSES-AND-DRUMS|南卡法律限制被奴役者聚会、鼓声和外出]]。1740年奴役法限制未经许可的外出、集会与持有鼓、号等器具，以削弱被奴役者组织集体行动的能力。",
        "殖民立法特别针对星期日、假期和集会，让种植园主可随时质询外出者是否有书面许可。",
        "这些措施与Stono起义中的行军鼓声、队伍扩张相呼应，成为殖民治安日常执行的工具。"
      ]
    },
    {
      "id": "1740-sc-chattel-inheritance",
      "heading": "二零、南卡法律将黑人与后代归入私人动产",
      "period_start_year": 1740,
      "period_end_year": 1740,
      "source_keys": [
        "18CT11-UNB1740-LAW"
      ],
      "paragraphs": [
        "在1740年，[[E18C-T11-1740-SC-CHATTEL-INHERITANCE|南卡法律将黑人与后代归入私人动产]]。1740年南卡奴役法规定被奴役者身份随母亲传递，并作为持有者的财产处理。",
        "通过把人的劳动能力和子女归入财产继承，法律维持种植园的世代奴役经济。",
        "这套制度将家庭拆散风险与种植园经营利益联系起来，殖民收入并不能仅凭法律条文计算。"
      ]
    },
    {
      "id": "1740-british-ft-mose-attack",
      "heading": "二一、英国佐治亚军攻占西班牙Fort Mose自由黑人据点",
      "period_start_year": 1740,
      "period_end_year": 1740,
      "source_keys": [
        "18CT11-NPS-MOSE",
        "18CT11-FL-PARK-MOSE",
        "18CT11-ORIG-V314",
        "18CT11-ORIG-V315",
        "18CT11-ORIG-V316"
      ],
      "paragraphs": [
        "在1740年，[[E18C-T11-1740-BRITISH-FT-MOSE-ATTACK|英国佐治亚军攻占西班牙Fort Mose自由黑人据点]]。1740年英属佐治亚领导人Oglethorpe攻打西属圣奥古斯丁期间占据Fort Mose，自由黑人居民被迫撤向圣奥古斯丁。",
        "来自英属殖民地的武装部队进入一处由逃亡黑人建立的自由聚落，对当地居住和防卫造成直接冲击。",
        "英国的堡垒占领是短暂军事实占，不能延伸绘制为英国拥有佛罗里达省。"
      ]
    },
    {
      "id": "1740-ft-mose-black-counterattack",
      "heading": "二二、Francisco Menéndez等西班牙与黑人守军夺回Fort Mose",
      "period_start_year": 1740,
      "period_end_year": 1740,
      "source_keys": [
        "18CT11-NPS-MOSE",
        "18CT11-FL-PARK-MOSE",
        "18CT11-ORIG-V317",
        "18CT11-ORIG-V314",
        "18CT11-ORIG-V316"
      ],
      "paragraphs": [
        "在1740年，[[E18C-T11-1740-FT-MOSE-BLACK-COUNTERATTACK|Francisco Menéndez等西班牙与黑人守军夺回Fort Mose]]。1740年Fort Mose黑人领袖Francisco Menéndez率协同部队反攻英属军队，收复堡垒；战斗使原堡损毁。",
        "自由黑人居民和西班牙军队选择主动反击英国短期占堡的军队，确保圣奥古斯丁防线安全。",
        "旧堡直到1752年才重新建设，居民的自由与社区存续经历了军事破坏。"
      ]
    },
    {
      "id": "1741-new-york-fort-george-fire",
      "heading": "二三、纽约Fort George火灾引起殖民政府恐慌",
      "period_start_year": 1741,
      "period_end_year": 1741,
      "source_keys": [
        "18CT11-NYCOURTS-1741",
        "18CT11-NYC-LPC1741"
      ],
      "paragraphs": [
        "在1741年，[[E18C-T11-1741-NEW-YORK-FORT-GEORGE-FIRE|纽约Fort George火灾引起殖民政府恐慌]]。1741年3月8日纽约英殖民总督官邸Fort George失火，随后多处火灾被指与奴役人口有关。",
        "当年粮食紧缺、战争恐慌及城市人口密集，共同促使殖民当局把火灾联系为大规模政治阴谋。",
        "各处火灾的真正起因和是否存在统一起义组织在历史研究中长期存在争议。"
      ]
    },
    {
      "id": "1741-new-york-trials",
      "heading": "二四、纽约殖民法院开始大规模审判所谓奴役阴谋",
      "period_start_year": 1741,
      "period_end_year": 1741,
      "source_keys": [
        "18CT11-NYCOURTS-1741",
        "18CT11-LOC-HORSMANDEN"
      ],
      "paragraphs": [
        "在1741年，[[E18C-T11-1741-NEW-YORK-TRIALS|纽约殖民法院开始大规模审判所谓奴役阴谋]]。1741年4月21日纽约法院在City Hall组建大陪审团调查纵火，5月开始对被控黑人和白人展开连续审判。",
        "法官Daniel Horsmanden参与调查又担任审判法官，证词中许多指控来自年轻仆役Mary Burton。",
        "逮捕范围不断扩大，部分被告缺少法律代理，审判程序本身成为殖民政治恐慌的一部分。"
      ]
    },
    {
      "id": "1741-new-york-executions",
      "heading": "二五、纽约殖民政府执行火刑与绞刑",
      "period_start_year": 1741,
      "period_end_year": 1741,
      "source_keys": [
        "18CT11-NYCOURTS-1741",
        "18CT11-NYC-LPC1741"
      ],
      "paragraphs": [
        "在1741年，[[E18C-T11-1741-NEW-YORK-EXECUTIONS|纽约殖民政府执行火刑与绞刑]]。1741年纽约案件中数十人被判死刑，纽约法院历史机构记载约三十人获死刑判决，另有资料对实际处决人数和构成给出不同数字。",
        "被控者中有奴役者、有色自由人以及贫困白人。多名黑人遭火刑或绞刑处决，审判记录留下被告姓名和证词。",
        "后世学者认为火灾是否存在统一的组织阴谋仍有争论，不能将殖民法院的全部指控视为已证事实。"
      ]
    },
    {
      "id": "1741-new-york-caribbean-transport",
      "heading": "二六、纽约殖民法院将多人流放加勒比继续奴役",
      "period_start_year": 1741,
      "period_end_year": 1741,
      "source_keys": [
        "18CT11-NYCOURTS-1741",
        "18CT11-NYC-LPC1741",
        "18CT11-LOC-HORSMANDEN"
      ],
      "paragraphs": [
        "在1741年，[[E18C-T11-1741-NEW-YORK-CARIBBEAN-TRANSPORT|纽约殖民法院将多人流放加勒比继续奴役]]。1741年纽约所谓阴谋案审判后约七十名被告被判运往加勒比地区，在奴役制度下继续服役。",
        "殖民司法通过流放将被告从原有家庭和社区移出，同时把他们送往加勒比奴役市场。",
        "流放判决人数与真正逐船抵达、转卖人数仍需核对判决表和商船清册。"
      ]
    }
