{
  "schema": "atlas-major-history-story-v1",
  "id": "E18-T34-T35-AUSTRALIA-FIRST-FLEET-1717-1799",
  "title": "1717—1799年澳大利亚：流放殖民、原住民失地与Pemulwuy抵抗",
  "subtitle": "1717刑罚运输、1770声索、1788殖民驻点、1789天花与1790—1799年边境战争、抵抗和司法不公",
  "region": "澳大利亚 · Warrane/Sydney Cove / Burramatta / Norfolk Island / Hawkesbury",
  "start_year": 1717,
  "end_year": 1799,
  "historical_end_year": null,
  "lead": "英国在澳大利亚建立流放殖民并非一次孤立的登陆：1717年刑罚运输、1770年对东岸的单方面声索、1787年纸面殖民管辖、1788年的实际军政驻点与原住民地权受侵占相互关联。随后船上大量流放者死亡、原住民天花疫情、国家命令的拘捕及武装行动、Pemulwuy组织的反抗与1799年法院失效，展现国家、商人和殖民者的不同责任。",
  "publication_status": "research_only",
  "publication_review": "not_submitted",
  "editorial_status": "research_preview_not_published",
  "publication_approval": "not_submitted",
  "series_family": [
    "T34",
    "T35"
  ],
  "parent_serial_topic_id": null,
