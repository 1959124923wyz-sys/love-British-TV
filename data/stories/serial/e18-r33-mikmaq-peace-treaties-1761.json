  "sections": [
    {
      "id": "1761-jun25-miramichi",
      "heading": "1、1761年6月25日Miramichi首领Joseph Shabecholouct与Belcher签订和平友好条约",
      "period_start_year": 1761,
      "period_end_year": 1761,
      "source_keys": [
        "18CR33-NOVA1",
        "18CR33-A-V5042",
        "18CR33-A-V5043",
        "18CR33-GHAL"
      ],
      "paragraphs": [
        "1761年，[[E18C-R33-MIK-1761-JUN25-MIRAMICHI|1761年6月25日Miramichi首领Joseph Shabecholouct与Belcher签订和平友好条约]]。新斯科舍省档案馆MG15卷18第9项收录Belcher和Miramichi首领Joseph Shabecholouct在Halifax签订条约的1761年6月25日转录。",
        "独立原住民社群谈判能力是重要历史政治事实，协议本身不产生未经测绘的英国全境土地实占。",
        "对应原T07-06候审E18A5-ACD-1761-MIRAMICHI-TREATY，Halifax现代市区点不等于当年签字建筑。"
      ]
    },
    {
      "id": "1761-jun25-shediac",
      "heading": "2、1761年6月25日Shediac首领Claude Atouash参加独立条约签署",
      "period_start_year": 1761,
      "period_end_year": 1761,
      "source_keys": [
        "18CR33-UNB",
        "18CR33-UPEI",
        "18CR33-GHAL"
      ],
      "paragraphs": [
        "1761年，[[E18C-R33-MIK-1761-JUN25-SHEDIAC|1761年6月25日Shediac首领Claude Atouash参加独立条约签署]]。UNB档案MG H54列Claude Atouash作为Shediac部落首领在Halifax同日条约上留标记、由Belcher及殖民政府官员签署接受。",
        "多个社区在同日分别采取外交行为，不将Mi’kmaq民族一概化为某一首领的同一决定。",
        "UNB文书索引未提供全部手印原图，不编造其他签约地点。"
      ]
    },
    {
      "id": "1761-jun25-belcher-dispatch",
      "heading": "3、1761年Belcher在公函中将多社群条约报告给伦敦",
      "period_start_year": 1761,
      "period_end_year": 1761,
      "source_keys": [
        "18CR33-UPEI",
        "18CR33-UNB"
      ],
      "paragraphs": [
        "1761年，[[E18C-R33-MIK-1761-JUN25-BELCHER-DISPATCH|1761年Belcher在公函中将多社群条约报告给伦敦]]。UPEI数字馆保存1761年6月25日Belcher公函，概述Shediac、Miramichi、Pokemouche与Cape Breton社群和平友好协商。",
        "英国殖民政府书面承认Mi’kmaq社区的多个政治代表，对条约性质按外交关系而非直接征地处理。",
        "不能据公函推算条约会场容纳人数或签署时分。"
      ]
    },
    {
      "id": "1761-nov9-francis-muis",
      "heading": "4、1761年11月9日LaHave首领Francis Muis与Belcher签订条约",
      "period_start_year": 1761,
      "period_end_year": 1761,
      "source_keys": [
        "18CR33-NOVA2",
        "18CR33-NOVA3",
        "18CR33-A-V5008",
        "18CR33-A-V5009",
        "18CR33-A-V5043",
        "18CR33-GHAL"
      ],
      "paragraphs": [
        "1761年，[[E18C-R33-MIK-1761-NOV9-FRANCIS-MUIS|1761年11月9日LaHave首领Francis Muis与Belcher签订条约]]。Nova Scotia Archives RG1卷430第20a号记LaHave首领Francis Muis与Belcher1761年11月9日在Halifax签约，现存材料是1812年5月5日Sigogne依原文本抄写的副本。",
        "11月LaHave外交与6月Miramichi、Shediac相互独立，1812年抄写本不可当作另一份1761签约原件。",
        "对应原T07-06候审E18A5-ACD-1761-MUIS-TREATY；原条约实物现未发现，土地转让及地界不绘。"
      ]
    }
  ],
