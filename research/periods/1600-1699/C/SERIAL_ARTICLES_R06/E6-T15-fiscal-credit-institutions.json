{
  "schema": "atlas-major-story-v1",
  "id": "E6-T15",
  "title": "贸易公司的债务、王室租金与1694年国家信用",
  "subtitle": "财政口径、债权人及国家战争借贷",
  "region": "伦敦、苏拉特、孟买",
  "start_year": 1657,
  "end_year": 1699,
  "historical_end_year": null,
  "parent_serial_topic_id": "E6-T15",
