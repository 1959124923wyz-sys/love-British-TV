{
  "schema": "atlas-major-story-v1",
  "id": "E6-T12",
  "title": "东印度公司：贸易、航行与地方政治权力",
  "subtitle": "从1600年特许到1690年代的商站与融资争论",
  "region": "伦敦、南亚、苏门答腊与印度洋",
  "start_year": 1600,
  "end_year": 1699,
  "historical_end_year": null,
  "parent_serial_topic_id": "E6-T12",
  "predecessor_story_ids": [],
  "successor_story_ids": [],
