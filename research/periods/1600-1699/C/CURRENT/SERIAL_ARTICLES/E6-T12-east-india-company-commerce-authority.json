{
  "schema": "atlas-major-story-v1",
  "id": "E6-T12",
  "title": "1600—1698年英格兰东印度公司：商贸特许、亚洲政权与武装据点",
  "subtitle": "从亚齐与苏拉特贸易到霍尔木兹、孟买、莫卧儿战争与1698公司竞争",
  "region": "英格兰、印度洋、南亚、波斯湾和东南亚",
  "start_year": 1600,
  "end_year": 1698,
  "historical_end_year": 1874,
  "parent_serial_topic_id": "E6-T12",
  "predecessor_story_ids": [],
  "successor_story_ids": [],
