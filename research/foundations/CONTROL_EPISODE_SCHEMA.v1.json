{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1959124923wyz-sys/love-British-TV/blob/research/control-foundations-02-20261011/research/foundations/CONTROL_EPISODE_SCHEMA.v1.json",
  "title": "爱英TV Control Episode (research protocol v1)",
  "description": "Research intake schema only. The live website has a different pilot format and must not consume it without migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "historical_place_label",
    "actor",
    "relationship",
    "time",
    "assertions",
    "geometry",
    "review"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{3,}$"
    },
    "historical_place_label": {
      "type": "string",
      "minLength": 2
    },
    "modern_lookup_label": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_claimant",
        "effective_administrator"
      ],
      "properties": {
        "legal_claimant": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_administrator": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_or_competing_authorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relationship": {
      "enum": [
        "CLAIM_ONLY",
        "TRADE_ONLY",
        "GARRISON",
        "TEMP_OCCUPATION",
        "CIVIL_CROWN",
        "COMPANY_RULE",
        "INDIRECT_RULE",
        "JOINT_CONTESTED",
        "UNKNOWN"
      ]
    },
    "control_facets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "courts",
          "taxes",
          "military",
          "land_registration",
          "diplomacy",
          "settlement_government",
          "ports_customs",
          "trade",
          "other"
        ]
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_from_year",
        "observed_to_year",
        "start_uncertainty",
        "end_uncertainty"
      ],
      "properties": {
        "observed_from_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1000,
          "maximum": 2100
        },
        "observed_to_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1000,
          "maximum": 2100
        },
        "start_uncertainty": {
          "type": "string"
        },
        "end_uncertainty": {
          "type": "string"
        },
        "legal_start_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "military_start_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "administrative_start_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_end_date": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "precision_grade",
        "status",
        "coordinates",
        "source_ids",
        "limitations"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "point",
            "line",
            "polygon",
            "multipolygon"
          ]
        },
        "precision_grade": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "status": {
          "enum": [
            "not_collected",
            "representative_only",
            "attested_locality",
            "inferred_dashed",
            "reviewed_polygon"
          ]
        },
        "coordinates": {
          "type": [
            "array",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "string"
        },
        "map_represents_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "map_publication_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "historical_map_shelfmark": {
          "type": [
            "string",
            "null"
          ]
        },
        "georeferencing_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "reuse_permission_status": {
          "enum": [
            "not_checked",
            "restricted",
            "requires_permission",
            "approved",
            "public_domain"
          ]
        }
      }
    },
    "financial_reference_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "significance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale",
        "review_status"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "rationale": {
          "type": "string"
        },
        "review_status": {
          "enum": [
            "provisional",
            "reviewed"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_status",
        "reviewer",
        "editorial_approval",
        "remaining_questions"
      ],
      "properties": {
        "research_status": {
          "enum": [
            "lead",
            "guide_checked",
            "abstract_checked",
            "document_checked",
            "corroborated",
            "editorially_approved"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "editorial_approval": {
          "type": "boolean"
        },
        "remaining_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement_zh",
        "source_ids",
        "support_type",
        "evidence_status"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "statement_zh": {
          "type": "string",
          "minLength": 10
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "opposing_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "support_type": {
          "enum": [
            "legal_text",
            "archival_administrative",
            "historical_map",
            "academic_article",
            "secondary_synthesis",
            "economic_ledger",
            "contemporary_press",
            "other"
          ]
        },
        "evidence_status": {
          "enum": [
            "lead",
            "guide_checked",
            "abstract_checked",
            "document_checked",
            "corroborated",
            "editorially_approved"
          ]
        },
        "folio_or_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "caveat": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "editorial_approval": {
                "const": true
              }
            },
            "required": [
              "editorial_approval"
            ]
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "research_status": {
                "const": "editorially_approved"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "geometry": {
            "properties": {
              "type": {
                "enum": [
                  "polygon",
                  "multipolygon"
                ]
              }
            }
          }
        },
        "required": [
          "geometry"
        ]
      },
      "then": {
        "properties": {
          "geometry": {
            "properties": {
              "precision_grade": {
                "enum": [
                  "L3",
                  "L4"
                ]
              },
              "reuse_permission_status": {
                "enum": [
                  "approved",
                  "public_domain"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
