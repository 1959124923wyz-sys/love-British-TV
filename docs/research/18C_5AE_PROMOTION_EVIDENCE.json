  "FORT_ANNE_ROYAL_PORT": {
    "title": "阿卡迪亚皇家港 · 安妮堡",
    "kind": "administration",
    "periods": [
      {
        "start_year": 1708,
        "end_year": 1709,
        "title": "皇家港 · 法军堡垒",
        "note": "1702年，法国工程师德拉巴特在阿兰河口主持修建新堡。1708年旧图绘有四座棱堡。皇家港是法国治理阿卡迪亚的驻地，米克马克人在当地捕鱼、狩猎并往返内陆水路。",
        "kind": "foreign_occupation"
      },
      {
        "start_year": 1710,
        "end_year": 1712,
        "title": "安纳波利斯皇家城 · 英军接收堡垒",
        "note": "1710年10月，尼科尔森指挥英军和新英格兰部队迫使法国守军投降，接收堡垒并将皇家港改名安纳波利斯皇家城。塞缪尔·韦奇率部留守。",
        "kind": "wartime_occupation"
      },
      {
        "start_year": 1713,
        "end_year": 1748,
        "title": "安纳波利斯皇家城 · 新斯科舍行政首府",
        "note": "1713年英法《乌得勒支条约》第十二条转让法国对阿卡迪亚和皇家港的权利。英国官员在此治理，1724年米克马克人攻击皇家城一带，1726年米克马克与瓦巴纳基诸族代表在此与英国确认《和平与友好条约》。",
        "kind": "administration"
      },
      {
        "start_year": 1749,
        "end_year": 1799,
        "title": "安纳波利斯皇家城 · 英军驻防",
        "note": "1749年首府迁到哈利法克斯，英军继续留守。1755年12月，英国殖民当局从安纳波利斯皇家城一带强制驱逐1,664名阿卡迪亚居民。1797至1799年兴建军官营房。",
        "kind": "administration"
      }
    ],
