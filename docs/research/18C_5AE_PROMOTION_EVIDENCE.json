  "PITT_BOUQUET_BLOCKHOUSE": {
    "title": "布凯碉楼",
    "kind": "military",
    "periods": [
      {
        "start_year": 1764,
        "end_year": 1771,
        "title": "布凯碉楼 · 皮特堡外防",
        "note": "布凯于1764年营建这座独立碉楼，作为皮特堡的外围工事。"
      },
      {
        "start_year": 1772,
        "end_year": 1777,
        "title": "布凯碉楼 · 麦基贸易站",
        "note": "英军撤去皮特堡驻防后，印第安事务代理人亚历山大·麦基利用碉楼作贸易站。",
        "kind": "company_post"
      },
      {
        "start_year": 1778,
        "end_year": 1784,
        "title": "布凯碉楼 · 麦基撤离后停业",
        "note": "麦基以效忠英王者身份于1778年离开匹兹堡，原贸易站停止经营。",
        "kind": "historic_ruins"
      },
      {
        "start_year": 1785,
        "end_year": 1788,
        "title": "布凯碉楼 · 商人克雷格的住宅",
        "note": "伊萨克·克雷格买下地块，并用堡中出售的砖块添建住宅。",
        "kind": "settlement"
      },
      {
        "start_year": 1789,
        "end_year": 1799,
        "title": "布凯碉楼 · 私人地产",
        "note": "克雷格一家迁出。碉楼和相邻地块转为民用地产。",
        "kind": "settlement"
      }
    ],
