  "ARCOT_FORT_CORE": {
    "title": "阿尔果德 · 旧主堡",
    "kind": "military",
    "periods": [
      {
        "start_year": 1751,
        "end_year": 1751,
        "title": "阿尔果德主堡 · 克莱武据堡并抵抗围军",
        "note": "卡纳提克纳瓦卜继承战争期间，英东印度公司支持穆罕默德·阿里。克莱武8月底进入守军撤走的堡垒，随后抵御钱达·萨希卜之子拉贾·萨希卜及法方援兵的围攻，11月解围。",
        "kind": "battle"
      },
      {
        "start_year": 1752,
        "end_year": 1757,
        "title": "阿尔果德 · 穆罕默德·阿里据堡",
        "note": "1751年围城结束后，英国支持的纳瓦卜穆罕默德·阿里与英方共同维持阿尔果德据点。",
        "kind": "settlement"
      },
      {
        "start_year": 1758,
        "end_year": 1758,
        "title": "阿尔果德主堡 · 英方撤守与法军占领",
        "note": "拉利进攻马德拉斯期间，英方撤回驻军，法国控制阿尔果德主堡。",
        "kind": "foreign_occupation"
      },
      {
        "start_year": 1759,
        "end_year": 1759,
        "title": "阿尔果德主堡 · 法军驻防",
        "note": "法军在撤离马德拉斯后仍控制阿尔果德。1760年2月英方夺回此堡。",
        "kind": "foreign_occupation"
      },
      {
        "start_year": 1760,
        "end_year": 1760,
        "title": "阿尔果德主堡 · 库特攻堡",
        "note": "1760年2月5日至10日，艾尔·库特率军攻打主堡，法军驻堡指挥官于10日投降。",
        "kind": "military"
      },
      {
        "start_year": 1761,
        "end_year": 1779,
        "title": "阿尔果德 · 卡纳提克纳瓦卜时期",
        "note": "英国支持的穆罕默德·阿里任纳瓦卜。1780年迈索尔军进入卡纳提克，阿尔果德的军事控制再次易手。",
        "kind": "settlement"
      },
      {
        "start_year": 1780,
        "end_year": 1782,
        "title": "阿尔果德 · 迈索尔占驻",
        "note": "第二次英迈战争期间，海德尔·阿里于1780年取得阿尔果德，并控制到1782年。",
        "kind": "foreign_occupation"
      },
      {
        "start_year": 1783,
        "end_year": 1799,
        "title": "阿尔果德 · 旧防御遗址",
        "note": "提普苏丹接掌迈索尔后拆毁部分防御设施，随后撤离阿尔果德。",
        "kind": "historic_ruins"
      }
    ],
