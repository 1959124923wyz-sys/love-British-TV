  "MYSORE_TELLICHERRY_FORT": {
    "title": "特利切里 · 东印度公司旧堡",
    "kind": "company_post",
    "periods": [
      {
        "start_year": 1708,
        "end_year": 1775,
        "title": "特利切里旧堡 · 海岸商站与胡椒贸易",
        "note": "1708年东印度公司取得筑堡许可。堡内商站承担驻防、发信与采购。1737年公司与伊凯里统治者办理胡椒、豆蔻和稻米贸易条件。"
      },
      {
        "start_year": 1776,
        "end_year": 1779,
        "title": "特利切里旧堡 · 商站降为驻扎官署",
        "note": "海达尔·阿里扩张后，公司贸易明显下滑。1776年公司把商站改成驻扎官署。",
        "kind": "administration"
      },
      {
        "start_year": 1780,
        "end_year": 1781,
        "title": "特利切里旧堡 · 迈索尔围攻",
        "note": "海达尔部属西尔达尔·汗与奇拉卡尔一方围攻公司驻堡。",
        "kind": "military_vicinity"
      },
      {
        "start_year": 1782,
        "end_year": 1782,
        "title": "特利切里旧堡 · 英军出击解围",
        "note": "阿宾登少校率兵出堡，迈索尔一方解除围攻。",
        "kind": "military"
      },
      {
        "start_year": 1783,
        "end_year": 1784,
        "title": "特利切里旧堡 · 接收芒格洛尔撤军",
        "note": "1784年1月恢复主事官署。2月4日芒格洛尔撤离的英军和印度士兵经海路抵达。",
        "kind": "administration"
      },
      {
        "start_year": 1785,
        "end_year": 1791,
        "title": "特利切里旧堡 · 北马拉巴尔沿岸据点",
        "note": "当地首领和商人仍分别与公司交涉。第三次战争开始后，特利切里又是英军沿岸集结点。"
      },
      {
        "start_year": 1792,
        "end_year": 1793,
        "title": "特利切里旧堡 · 兑现胡椒和租赋",
        "note": "公司在此向奇拉卡尔首领议定把胡椒收归公司，并以现金或胡椒缴租。1792年协议列出1793年两笔应缴期。",
        "kind": "revenue"
      },
      {
        "start_year": 1794,
        "end_year": 1799,
        "title": "特利切里旧堡 · 马拉巴尔监督官下属据点",
        "note": "1794年公司撤掉独立主事官署，改由马拉巴尔监督官直接管理。特利切里继续承担北部行政和港务。",
        "kind": "administration"
      }
    ],
